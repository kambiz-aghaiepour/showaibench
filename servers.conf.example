; show-ai-bench-results - inference servers (OpenAI-compatible)
;
; Fields:
;   url            = scheme + host + port (the app appends /v1)
;   model          = model id sent in the request body (OpenAI "model" field)
;   tokenizer-name = HF Hub repo used for prompt sizing / token counting
;   api-key        = optional Bearer token (omit or leave blank for no auth)
;   extra-body     = extra JSON fields merged into benchmark chat completions
;                    (here: disable reasoning/thinking so the benchmark measures
;                     answer tokens, not chain-of-thought)

[dgx]
url = http://192.168.1.39:8000
model = Qwen/Qwen3.8-27B
tokenizer-name = Qwen/Qwen3.8-27B
api-key =
extra-body = chat_template_kwargs={"enable_thinking":false}

[llama-cpp]
url = http://127.0.0.1:11434
model = Qwen3.8-27B-UD-Q4_K_M
tokenizer-name = Qwen/Qwen3.8-27B
api-key =
extra-body = chat_template_kwargs={"enable_thinking":false}

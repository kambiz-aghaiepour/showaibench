# showaibench - example server configuration
#
# Copy this file to servers.conf and edit the values:
#   cp servers.conf.example servers.conf
#
# Each section is one OpenAI-compatible inference server to benchmark.
# All fields are optional except url, model and tokenizer-name.

[dgx]
# scheme + host + port (the app appends /v1 to every request path)
url = http://192.168.1.10:8000
# model id as it appears in the server's /v1/models response
model = org/model-name
# HF Hub repo used by llama-benchy for token counting (prompt sizing)
tokenizer-name = org/model-name
# optional Bearer token sent as Authorization: Bearer <api-key> (omit/empty = no auth)
api-key =
# extra JSON fields merged into benchmark chat-completion requests
# (common example: disable reasoning/thinking for the benchmark)
extra-body = chat_template_kwargs={"enable_thinking":false}

[local]
url = http://127.0.0.1:11434
model = my-local-model
tokenizer-name = org/local-model
api-key =
extra-body =
